# ---------------------------------------------
# TripLink / RailMeet Environment Configuration
# ---------------------------------------------

# Application
NEXT_PUBLIC_APP_NAME="TripLink"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Backend / Database (Supabase)
# Sign up at https://supabase.com to enable cloud sync & persistence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Indian Railways / PNR API (Optional - for live IRCTC lookup)
# RapidAPI Indian Railway / PNR Status service
IRCTC_RAPIDAPI_KEY=
IRCTC_RAPIDAPI_HOST=irctc1.p.rapidapi.com

# SMS Gateway (Optional - for production OTP delivery)
# e.g., MSG91, Twilio, or Fast2SMS
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=TRPLNK
