# ---------------------------------------------
# TripLink / RailMeet Environment Configuration
# ---------------------------------------------

# Application
NEXT_PUBLIC_APP_NAME="TripLink"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
PORT=3000

# Backend / Database (Supabase)
# Sign up at https://supabase.com to enable cloud sync & persistence
# All database access is server-side (src/app/api/db) with a Supabase secret key.
# Dashboard > Settings > API Keys > "Publishable and secret API keys" tab > secret key (sb_secret_...).
# Never expose it to the browser (no NEXT_PUBLIC_ prefix). No publishable/anon key is needed:
# the browser never talks to Supabase directly.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Signs the httpOnly session cookie. 32+ random chars, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Indian Railways / PNR API (Optional - for live IRCTC lookup)
# RapidAPI Indian Railway / PNR Status service
IRCTC_RAPIDAPI_KEY=
IRCTC_RAPIDAPI_HOST=irctc1.p.rapidapi.com

# SMS Gateway (Fast2SMS). Without it, OTP runs in dev mode (demo code 1234, non-production only).
FAST2SMS_API_KEY=

# Flight lookup (Optional - AeroDataBox via RapidAPI, free tier: https://rapidapi.com/aedbx-aedbx/api/aerodatabox)
# Without it, flights are entered manually (airport codes).
AERODATABOX_API_KEY=
